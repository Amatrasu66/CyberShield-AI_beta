# CyberShield AI API configuration
# Copy to .env and fill in real values. Never commit .env.

# --- App identity ---
APP_NAME=CyberShield AI API
API_VERSION=1.0
API_URL_PREFIX=/api
APP_ENV=development
FLASK_ENV=development
FLASK_DEBUG=false

# --- Security ---
SECRET_KEY=change-me-to-a-long-random-secret
MAX_CONTENT_LENGTH=1000000
JWT_EXPIRATION_MINUTES=60
JWT_ALGORITHM=HS256

# --- CORS ---
CORS_ORIGINS=*
CORS_SUPPORTS_CREDENTIALS=false

# --- Logging ---
LOG_LEVEL=INFO
REQUEST_LOG_ENABLED=true

# --- Scanner ---
SCANNER_TIMEOUT=10
SCANNER_MAX_RESPONSE_SIZE=512000
SCANNER_MAX_REDIRECTS=5
SCANNER_ALLOW_PRIVATE_ADDRESSES=false
SCANNER_USER_AGENT=CyberShieldAI-Scanner/1.0 (educational assessment)

# --- Input limits ---
PASSWORD_MAX_LENGTH=4096
EMAIL_MAX_LENGTH=50000
EMAIL_PDF_MAX_SIZE=1000000
LOG_MAX_LENGTH=500000
LOG_MAX_LINES=10000
CRYPTO_MAX_INPUT_LENGTH=100000
URL_MAX_LENGTH=2048

# --- Supabase (PostgreSQL database) ---
# From the Supabase dashboard: Project Settings > API Keys.
SUPABASE_URL=https://your-supabase-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
SUPABASE_SECRET_KEY=your-supabase-secret-key

# --- Supabase JWT verification (auth) ---
# Single algorithm or comma-separated list (e.g. ES256,RS256).
SUPABASE_JWT_ALGORITHM=ES256
SUPABASE_JWT_AUDIENCE=authenticated
SUPABASE_JWT_ISSUER=
SUPABASE_JWKS_URL=

# --- Reports (PDF generation) ---
REPORT_STORAGE_BUCKET=report-pdfs
REPORT_SIGNED_URL_EXPIRES=3600

# --- ML model paths ---
PHISHING_MODEL_PATH=../models/phishing_model.pkl
LOG_MODEL_PATH=../models/log_analyzer.pkl
