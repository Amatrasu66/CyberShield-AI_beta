# ============================================================
# CyberShield AI Backend - Environment Configuration
# Copy this file to `.env` and fill in real values.
# NEVER commit a real `.env` file.
# ============================================================

# ---- Flask -------------------------------------------------
FLASK_APP=app.py
APP_ENV=development
FLASK_DEBUG=1
PORT=5000

# REQUIRED in production: a long random string used to sign JWT tokens.
# Generate with:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-in-production
JWT_EXPIRATION_MINUTES=60
JWT_ALGORITHM=HS256

# ---- Request limits ----------------------------------------
# Maximum accepted request body in bytes (1 MB).
MAX_CONTENT_LENGTH=1000000

# ---- CORS --------------------------------------------------
# Comma-separated list of allowed origins. Use "*" only in development.
CORS_ORIGINS=*
CORS_SUPPORTS_CREDENTIALS=false

# ---- Logging -----------------------------------------------
LOG_LEVEL=INFO
REQUEST_LOG_ENABLED=true

# ---- Website Scanner ---------------------------------------
SCANNER_TIMEOUT=10
SCANNER_MAX_RESPONSE_SIZE=512000
SCANNER_MAX_REDIRECTS=5
# Refuse targets resolving to private/loopback addresses (SSRF guard).
# Set true only for local development against LAN targets.
SCANNER_ALLOW_PRIVATE_ADDRESSES=false
SCANNER_USER_AGENT=CyberShieldAI-Scanner/1.0 (educational assessment)

# ---- Input size limits -------------------------------------
PASSWORD_MAX_LENGTH=4096
EMAIL_MAX_LENGTH=50000
LOG_MAX_LENGTH=500000
LOG_MAX_LINES=10000
CRYPTO_MAX_INPUT_LENGTH=100000
URL_MAX_LENGTH=2048

# ---- Supabase (PostgreSQL database) ------------------------
# From the Supabase dashboard: Project Settings > API.
# SUPABASE_URL is the project's API URL, e.g. https://xyzcompany.supabase.co
SUPABASE_URL=
# Legacy client key; kept for compatibility. Prefer SUPABASE_ANON_KEY.
SUPABASE_KEY=
# Public anon key (safe to expose; used by the default client).
SUPABASE_ANON_KEY=
# Privileged service-role key (server-side only). NEVER commit or expose.
SUPABASE_SERVICE_ROLE_KEY=

# ---- Future: ML model paths (ML phase) ---------------------
PHISHING_MODEL_PATH=../models/phishing_model.pkl
LOG_MODEL_PATH=../models/log_analyzer.pkl
